#!/usr/bin/env bash
# Copy to env.sh, edit paths, then: source env.sh
export TTT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export TTT_DATA=/absolute/path/to/tokenized-data
export TTT_CKPT=/absolute/path/to/checkpoints
export TTT_OUT="$TTT_ROOT/results"
export WEBSHOP_DIR=/absolute/path/to/WebShop
export WEBSHOP_DATA=/absolute/path/to/webshop-catalogue.json
export PYTHONPATH="$TTT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
